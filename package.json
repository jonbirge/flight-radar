{
  "name": "flight-radar",
  "version": "1.2.0",
  "description": "Real-time US flight tracker with FAA radar center aesthetic",
  "main": "main.js",
  "author": "Jonathan Birge",
  "cesiumVersion": "1.119.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/copy-cesium.js",
    "setup": "node scripts/copy-cesium.js",
    "pull-data": "node scripts/download-airports.js && node scripts/download-airspace.js",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.jon.flight-radar",
    "productName": "FlightRadar",
    "asar": false,
    "icon": "assets/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js",
      "package.json",
      "src/**/*",
      "shared/**/*",
      "vendor/**/*",
      "assets/icon.ico"
    ],
    "win": {
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3D Flight Radar"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "cesium": "1.119.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.7.0"
  }
}
