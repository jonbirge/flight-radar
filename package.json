{
  "name": "flight-radar",
  "version": "1.13.0",
  "description": "Real-time US flight tracker with FAA radar center aesthetic",
  "main": "main.js",
  "author": "Jonathan Birge",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:snap:js": "node scripts/obfuscate-snap.js",
    "postinstall": "node scripts/copy-cesium.js",
    "setup": "node scripts/copy-cesium.js",
    "pull-data": "node scripts/download-airports.js && node scripts/download-airspace.js && node scripts/download-waypoints.js",
    "pack": "electron-forge package",
    "dist": "electron-forge make"
  },
  "config": {
    "forge": "./forge.config.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "*",
    "@electron-forge/maker-deb": "*",
    "@electron-forge/maker-squirrel": "*",
    "cesium": "*",
    "electron": "*",
    "javascript-obfuscator": "*",
    "terser": "*"
  }
}
