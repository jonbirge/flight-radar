{
  "name": "flight-radar",
  "version": "1.3.0",
  "description": "Real-time US flight tracker with FAA radar center aesthetic",
  "main": "main.js",
  "author": "Jonathan Birge",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:snap:js": "node scripts/obfuscate-snap.js",
    "postinstall": "node scripts/copy-cesium.js",
    "setup": "node scripts/copy-cesium.js",
    "pull-data": "node scripts/download-airports.js && node scripts/download-airspace.js && node scripts/download-waypoints.js",
    "pack": "electron-builder dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.birge.flight-radar",
    "productName": "FlightRadar",
    "asar": false,
    "icon": "assets/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js",
      "package.json",
      "src/**/*",
      "shared/**/*",
      "vendor/**/*",
      "assets/icon.ico"
    ],
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3D Flight Radar"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "cesium": "*",
    "electron": "*",
    "electron-builder": "*",
    "javascript-obfuscator": "5.3.0",
    "terser": "5.46.0"
  }
}
