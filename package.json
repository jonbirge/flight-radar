{
  "name": "flight-radar",
  "version": "2.31.0",
  "description": "Real-time 3D flight tracker with Material 3 Expressive design",
  "main": "out/main/index.js",
  "license": "GPL-3.0-or-later",
  "author": "Jonathan Birge",
  "scripts": {
    "start": "electron-vite preview",
    "predev": "node scripts/generate-icon.js",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/generate-icon.js",
    "build": "electron-vite build",
    "build:snap:js": "node scripts/obfuscate-snap.js",
    "postinstall": "node scripts/copy-cesium.js && node scripts/check-fonts.js && node scripts/patch-electron-plist.js && npm run pull-data",
    "pull-data": "node scripts/download-airports.js && node scripts/download-airspace.js && node scripts/download-waypoints.js && node scripts/promote-airports.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.birgefuller.flightradar",
    "productName": "Flight Radar 3D",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": false,
      "installerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Jonathan Birge"
    }
  },
  "dependencies": {
    "pocketbase": "^0.25.0"
  },
  "devDependencies": {
    "cesium": "*",
    "electron": "*",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "javascript-obfuscator": "*",
    "terser": "*",
    "vite": "^7.3.2",
    "vite-plugin-static-copy": "^3.3.0",
    "vitest": "^4.1.2"
  },
  "cesiumVersion": "1.140.0"
}
